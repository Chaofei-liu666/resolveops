# ResolveOps local development configuration
#
# Copy this file to .env before running: python scripts/dev.py
# Do not commit .env. It may contain ERPNext and LLM credentials.

# -----------------------------------------------------------------------------
# 1. Minimal local runtime
# -----------------------------------------------------------------------------

APP_ENV=local

# Default: a local SQLite file. No database service or Docker is required.
DATABASE_URL=sqlite:///./data/resolveops.db

# Optional service deployment: replace DATABASE_URL with a PostgreSQL URL.
# DATABASE_URL=postgresql+psycopg://resolveops:<password>@<host>:5432/resolveops

# Webhook and local operator authentication.
WEBHOOK_SECRET=local-webhook-secret
OPERATOR_API_KEY=local-ops-key

# Optional local bootstrap only: subject:role:key;subject:role:key
# Do not use OPERATOR_SEED_KEYS in staging/production.
OPERATOR_SEED_KEYS=local-sales:sales_manager:local-sales-key;local-finance:finance_manager:local-finance-key;local-warehouse:warehouse_manager:local-warehouse-key;local-procurement:procurement_manager:local-procurement-key

# -----------------------------------------------------------------------------
# 2. ERPNext sandbox integration
# -----------------------------------------------------------------------------
#
# ERPNext is the current reference business system. For full end-to-end Cases,
# configure a reachable ERPNext sandbox and an integration user API key/secret.
#
ERPNEXT_BASE_URL=http://127.0.0.1:8080
ERPNEXT_API_KEY=replace-me
ERPNEXT_API_SECRET=replace-me

# ERPNext defaults used by fault injection / stock reconciliation in sandbox.
ERPNEXT_COMPANY=ResolveOps 测试贸易有限公司
ERPNEXT_STOCK_DIFFERENCE_ACCOUNT=Temporary Opening - ROPS
ERPNEXT_DEFAULT_VALUATION_RATE=100

# Fallback only when logistics_lanes config is not available.
ALTERNATIVE_WAREHOUSES=重庆仓 - ROPS

# -----------------------------------------------------------------------------
# 3. LLM provider
# -----------------------------------------------------------------------------
#
# ResolveOps expects an OpenAI-compatible chat-completions endpoint.
# Top-level CLI chat and Agent planning use these values when configured.

LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# -----------------------------------------------------------------------------
# 4. Runtime safety budgets
# -----------------------------------------------------------------------------

TASK_LEASE_SECONDS=90
AGENT_MAX_INVESTIGATION_TURNS=8
AGENT_MAX_READ_TOOL_CALLS=12
AGENT_READ_TOOL_PARALLELISM=4
AGENT_MAX_PLAN_REPAIRS=1
AGENT_MAX_REPLANS=2
APPROVAL_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# 5. Local/test fault injection
# -----------------------------------------------------------------------------
#
# This lets the CLI/API modify ERPNext sandbox data through ERPNext APIs to
# simulate failures such as inventory changing before execution.
# Never enable this in production.

ENABLE_FAULT_INJECTION=true
