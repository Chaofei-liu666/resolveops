# ResolveOps Desktop local runtime.  This file is created in the current
# Windows user's app-data directory on first launch; do not put shared secrets
# in the installer.
APP_ENV=desktop
DATABASE_URL=sqlite:///./data/resolveops.db
WEBHOOK_SECRET=local-webhook-secret
OPERATOR_API_KEY=local-ops-key
OPERATOR_SEED_KEYS=local-sales:sales_manager:local-sales-key;local-finance:finance_manager:local-finance-key;local-warehouse:warehouse_manager:local-warehouse-key;local-procurement:procurement_manager:local-procurement-key
ERPNEXT_BASE_URL=http://127.0.0.1:8080
ERPNEXT_API_KEY=replace-me
ERPNEXT_API_SECRET=replace-me
ERPNEXT_COMPANY=ResolveOps 测试贸易有限公司
ERPNEXT_STOCK_DIFFERENCE_ACCOUNT=Temporary Opening - ROPS
ERPNEXT_DEFAULT_VALUATION_RATE=100
ALTERNATIVE_WAREHOUSES=重庆仓 - ROPS
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
TASK_LEASE_SECONDS=90
AGENT_MAX_INVESTIGATION_TURNS=8
AGENT_MAX_READ_TOOL_CALLS=12
AGENT_READ_TOOL_PARALLELISM=4
AGENT_MAX_PLAN_REPAIRS=1
AGENT_MAX_REPLANS=2
APPROVAL_TTL_SECONDS=3600
ENABLE_FAULT_INJECTION=false
